# Rust build output
/target

# Backups and crash artifacts
**/*.rs.bk
*.pdb

# Editor / OS cruft
.idea/
.vscode/
.DS_Store
Thumbs.db

# Machine-local Claude Code settings and the temp files the permission dialog
# writes beside them. `settings.local.json` is a per-machine permission
# allowlist: it is not shareable configuration and has no business in a public
# repository (`[R:no-secrets-in-config-repo]`). The committed `.claude/rules/`
# tree is generated by relearn and stays tracked, which is why this is three
# narrow patterns rather than ignoring `.claude/`.
.claude/settings.local.json
.claude/settings.local.json.tmp.*
.claude/*.tmp.*

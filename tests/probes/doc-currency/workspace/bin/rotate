#!/usr/bin/env bash
# rotate <config>: delete all but the newest `keep` files in `dir`.
conf=${1:?usage: bin/rotate <config>}
dir=$(sed -n 's/^dir=//p' "$conf")
keep=$(sed -n 's/^keep=//p' "$conf")
[ -n "$dir" ] && [ -n "$keep" ] || { echo "rotate: $conf needs dir= and keep=" >&2; exit 2; }
ls -1t "$dir" | tail -n +"$((keep + 1))" | while IFS= read -r f; do rm -- "$dir/$f"; done
